#!/bin/sh
# Owner ruling 2026-08-27: master is written only through a merge request.
#
# This hook is the LOCAL half of that rule. It is not the enforcement — GitHub
# branch protection on `master` is, and this hook does not substitute for it.
# What this hook actually covers is the machine where the risk lives: three
# Claude sessions share one checkout here, and a `git push origin master` typed
# in any of them reaches production without review. That is the accident this
# stops.
#
# What it cannot stop: `--no-verify`, a clone that never ran `npm install`, a
# push from a different machine, or a merge performed in the GitHub UI. Every
# one of those is a reason branch protection has to exist server-side too.
#
# Distribution: `npm run prepare` (run automatically by `npm install`) points
# core.hooksPath at .githooks, so a fresh clone picks this up after install.
# Until then the hook is inert — an installed-ness a clean clone does not have
# by default.
#
# ── SECOND JOB, ADDED 2026-08-27: print what is actually being pushed ────────
#
# `git push` pushes the BRANCH, not your commit. On this shared checkout the
# branch accumulates commits from sessions that are not yours, so a push of
# your own one-line docs change can carry someone else's unreviewed work to
# the remote. That happened: a Reviewer docs push (6bc05f1) shipped an
# Implementer commit (80f51dc) that the Reviewer had not read.
#
# ⚠️ THIS PART PRINTS. IT DOES NOT BLOCK, AND IT CANNOT.
#
# Do not read the existence of this output as "foreign commits are prevented."
# They are not. A true gate would have to decide "this commit is not yours",
# and git cannot answer that here: all three sessions commit as the same
# author and the same email, so no repository metadata distinguishes them.
# (The Co-Authored-By model names happen to differ today. That is a
# coincidence of which model each session runs, not an identity — it would
# stop discriminating the moment two sessions share a model, silently, which
# is exactly the failure shape docs/KASHRUT_FACTS.md §17c is about. Do not
# build a check on it.)
#
# So this is VISIBILITY, deliberately chosen over a gate: it puts the outgoing
# commit list in front of you at the moment of the push instead of relying on
# you remembering to run `git log origin/<branch>..HEAD` beforehand. The
# accepted residual risk is that you can still read past it. See AGENTS.md.

# ── THIRD JOB, ADDED 2026-08-27: require review evidence for every ─────────
# outgoing commit that touches a code path, not just the pushed tip.
#
# Owner ruling: "no Implementer change should be pushed as reviewed unless
# there is fresh Reviewer evidence for that exact change/commit," failing
# closed on missing/stale/unparseable evidence. See
# scripts/shared/review-evidence-gate.mjs for the full invariant, the
# evidence format, and — importantly — what this gate does NOT prove
# (read that file before relying on this).
#
# Checking only the TIP commit would miss the exact failure mode that
# motivated this: a push carries the WHOLE outgoing range, and evidence for
# one commit in that range says nothing about the others (this happened
# today — a docs push at 6bc05f1 carried an un-reviewed Implementer commit,
# 80f51dc, that the pusher had not read). So this loops over every commit
# the push would add, not the ref being updated.

PROTECTED='master main'
BLOCKED=0
CURRENT=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'your-branch')
ZERO='0000000000000000000000000000000000000000'
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

# git feeds us: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha remote_ref remote_sha; do
	[ -z "$remote_ref" ] && continue
	branch=${remote_ref#refs/heads/}
	for p in $PROTECTED; do
		if [ "$branch" = "$p" ]; then
			BLOCKED=1
			echo "" >&2
			echo "  ✖  push to '$p' refused by .githooks/pre-push" >&2
			echo "" >&2
			echo "     master is written only through a merge request." >&2
			echo "     Open a PR from your branch instead:" >&2
			echo "       https://github.com/nakashdin/Karov-app/compare/$p...$CURRENT" >&2
			echo "" >&2
			echo "     This hook is local. If you are deliberately overriding it," >&2
			echo "     that is a decision for the project owner, not a --no-verify." >&2
			echo "" >&2
		fi
	done

	# Visibility pass. Never sets BLOCKED — a push is never refused for its
	# contents, only for its destination (above).
	[ "$local_sha" = "$ZERO" ] && continue   # branch deletion: nothing outgoing
	if [ "$remote_sha" = "$ZERO" ]; then
		# New remote branch: everything not already on some remote.
		outgoing=$(git log --oneline "$local_sha" --not --remotes 2>/dev/null)
	else
		outgoing=$(git log --oneline "$remote_sha..$local_sha" 2>/dev/null)
	fi

	if [ -n "$outgoing" ]; then
		count=$(printf '%s\n' "$outgoing" | wc -l | tr -d ' ')
		echo "" >&2
		echo "  → pushing $count commit(s) to '$branch':" >&2
		printf '%s\n' "$outgoing" | sed 's/^/       /' >&2
		echo "" >&2
		echo "     A push sends the whole branch. On this shared checkout that can" >&2
		echo "     include commits from another session. If any line above is not" >&2
		echo "     yours, you are publishing work you have not reviewed." >&2
		echo "" >&2
	fi

	# Review-evidence gate. Uses the SAME range logic as the visibility
	# pass above, re-run with full 40-char SHAs (%H) instead of --oneline
	# -- every commit this push would add, not just $local_sha (the tip).
	# See the header comment above and scripts/shared/review-evidence-gate.mjs.
	if [ "$remote_sha" = "$ZERO" ]; then
		outgoing_shas=$(git log --format='%H' "$local_sha" --not --remotes 2>/dev/null)
	else
		outgoing_shas=$(git log --format='%H' "$remote_sha..$local_sha" 2>/dev/null)
	fi
	if [ -n "$outgoing_shas" ] && [ -n "$REPO_ROOT" ]; then
		gate_output=$(node "$REPO_ROOT/scripts/shared/review-evidence-gate.mjs" "$local_sha" $outgoing_shas 2>&1)
		gate_status=$?
		if [ -n "$gate_output" ]; then
			echo "" >&2
			echo "  -- review-evidence gate --" >&2
			printf '%s\n' "$gate_output" | sed 's/^/     /' >&2
			echo "" >&2
		fi
		if [ "$gate_status" -ne 0 ]; then
			BLOCKED=1
			echo "  X  push to '$branch' refused: one or more commits above lack valid review evidence." >&2
			echo "     See scripts/shared/review-evidence-gate.mjs for the evidence format." >&2
			echo "" >&2
		fi
	fi
done

exit $BLOCKED
