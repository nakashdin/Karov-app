{
  "name": "kosher-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/heebo": "^0.4.2",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "expo": "~56.0.20",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.25",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.17",
    "expo-location": "~56.0.24",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.25",
    "minisearch": "^7.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reload-data": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "import:synagogues": "node importers/synagogues/importer.ts",
    "import:restaurants": "node importers/kosher-restaurants/importer.ts",
    "import:mikvahs": "node importers/mikvahs/importer.ts",
    "import:all": "node importers/synagogues/importer.ts && node importers/kosher-restaurants/importer.ts",
    "import:unified-demo": "node importers/unified/example/run-demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --passWithNoTests",
    "build:web": "expo export --platform web",
    "doctor": "expo-doctor",
    "verify": "npm run typecheck && npm run lint && npm test && npm run data:validate",
    "data:validate": "node scripts/validate-data.mjs",
    "data:baseline": "node scripts/validate-data.mjs --update",
    "build:preview": "npx eas-cli@22 build --profile preview --platform all",
    "build:production": "npx eas-cli@22 build --profile production --platform all",
    "update:preview": "npx eas-cli@22 update --branch preview --auto",
    "update:production": "npx eas-cli@22 update --branch production --auto",
    "eas": "npx eas-cli@22"
  },
  "private": true
}
