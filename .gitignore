# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

.vercel
.env*

# Downloaded kashrut certificate PDFs (regenerate with importers/tzohar/extract-cert-expiry.mjs)
importers/tzohar/cert-cache/

# Historical dataset snapshots — kept on disk, out of git (see docs/ARCHITECTURE_REVIEW.md P1-11)
data-backups/
*.bak-location-shape
*.bak-dedupe
*.bak-orphan-cities

# Store credentials — never commit (referenced by eas.json submit profiles)
secrets/
*-service-account.json
*.keystore
AuthKey_*.p8
