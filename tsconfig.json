{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src/**/*",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    ".vercel",
    "importers",
    "scripts",
    "research",
    "web",
    "data-backups"
  ]
}
